<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record  id="view_users_form_inherit_thermal_base" model="ir.ui.view">
        <field name="name">res.users.form.inherit.thermal.base</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[@name='preferences']" position="inside">
                <group string="Thermal Reports">
                    <field name="thermal_size"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>