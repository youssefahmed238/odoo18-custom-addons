<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot View -->
    <record id="view_warehouse_product_pivot" model="ir.ui.view">
        <field name="name">warehouse.product.pivot</field>
        <field name="model">warehouse.product</field>
        <field name="arch" type="xml">
            <pivot string="Warehouse Products" disable_linking="1">
                <field name="product_id" type="row"/>
                <field name="location_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vit_warehouse_products_dashboard" model="ir.actions.act_window">
        <field name="name">Warehouse Products</field>
        <field name="res_model">warehouse.product</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_warehouse_product_pivot"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products found in your default warehouse.
            </p>
            <p>
                This dashboard shows all products in stock for your default warehouse.
                Products are displayed by location with their quantities.
            </p>
        </field>
    </record>

</odoo>