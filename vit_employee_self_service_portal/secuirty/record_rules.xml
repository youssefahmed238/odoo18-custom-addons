<odoo>
    <data noupdate="1">

        <!-- Portal user can only read his own partner -->
        <record id="portal_partner_rule" model="ir.rule">
            <field name="name">Portal: read allowed partners</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">
                ['|',
                    ('id', '=', user.partner_id.id),
                    ('id', '=', user.commercial_partner_id.id)
                ]
            </field>
        </record>
                <!-- Portal user can only read his own approval requests -->
        <record id="portal_approval_request_rule" model="ir.rule">
          <field name="name">Portal: own approval requests</field>
          <field name="model_id" ref="approvals.model_approval_request"/>
          <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
          <field name="domain_force">[('request_owner_id', '=', user.id)]</field>
        </record>
