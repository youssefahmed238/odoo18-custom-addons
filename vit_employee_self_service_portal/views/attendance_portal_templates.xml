<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_menu_attendance" name="Portal layout : Attendance Logs menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li id="portal_breadcrumbs_attendance"
                t-if="page_name == 'attendance' or attendance"
                t-attf-class="breadcrumb-item #{'active ' if not attendance else ''}">
                <a t-if="attendance" t-attf-href="/my/attendance?{{ keep_query() }}">Attendance Logs</a>
                <t t-else="">Attendance Logs</t>
            </li>
            <li t-if="attendance" class="breadcrumb-item active">
                <t t-out="attendance"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_attendance" name="Show Attendance Logs of Employee" customize_show="True"
              inherit_id="portal.portal_my_home" priority="52">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry" t-if="partner.employee_ids">
                <t t-set="icon" t-value="'/hr_attendance/static/description/icon.png'"/>
                <t t-set="title">Attendance</t>
                <t t-set="url" t-value="'/my/attendance'"/>
                <t t-set="text">Follow, view your attendance logs</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_my_attendance" name="My Attendance Logs">

        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Attendance</t>
            </t>
            <h4><img src="/hr_attendance/static/description/icon.png" height="40px" width="40px"/>
                My Attendance
            </h4>
            <t t-if="not attendances">
                <p>There are currently no Attendance Logs for your account.</p>
            </t>
            <div class="table-responsive">
                <t t-if="attendances" t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th scope="col">
                                <span class='d-none d-md-inline'>Employee ID #</span>
                                <span class='d-block d-md-none'>Ref.</span>
                            </th>
                            <th scope="col" class="text-center">Attendance Check In</th>
                            <th scope="col" class="text-center">Attendance Check Out</th>
                            <th scope="col" class="text-right">Work Hours</th>
                        </tr>
                    </thead>
                    <t t-foreach="attendances" t-as="attendance">
                        <tr>
                            <td>
                                <t t-esc="attendance.employee_id.name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="attendance.check_in"/>
                            </td>
                            <td class="text-center">

                                <span class='d-md-inline' t-field="attendance.check_out"/>
                            </td>
                            <td class="text-right">
                                <span class='d-md-inline'
                                      t-esc="attendance.worked_hours" t-options="{'widget':'float_time'}"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </div>
            <div class="col-12 text-center" style="text-align: center;margin:16px;">
                <a role="button" t-attf-href="/my" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To Home
                    Page
                </a>
            </div>
        </t>
    </template>
</odoo>
