            <div class="oe_structure">
                <section class="vit-fancy-form-section">
                    <h2 style="text-align:center;margin:16px;font-weight: bold">New Request</h2>
                    <div class="container vit-fancy-form">


                        <!-- Use POST to our controller -->

                        <form action="/create_new_leave" method="post" class="form" enctype="multipart/form-data">

                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="leave_id" t-att-value="leave_id"/>

                            <strong>
                                <label name="Name">Your Name</label>
                            </strong>
                            <input type="text" class="form-control" name="name" required="required"
                                   t-att-value="name or partner.name" readonly="True" style="width:400px;"/>

                            <div style="margin-top:25px;"></div>

                            <label name="Leave Type" style="font-weight: bold; width:200px;">Time Off Type</label>
                            <select id="leave_types_details"
                                    name="leave_type_detail"
                                    class="form-control col-6" required="True">
                                <option value="" selected="selected">Select...</option>
                                <t t-foreach="leave_type" t-as="leave_t">
                                    <option t-att-value="leave_t.id"
                                            t-att-selected="leave_t.id == (leave_type_detail and int(leave_type_detail) or -1)">
                                        <t t-esc="leave_t.name"/>
                                    </option>
                                </t>
                            </select>

                            <div style="margin-top:25px;"></div>

                            <label name="Leave Type" style="font-weight: bold">Date From</label>
                            <div id="date_leave_from_container" data-target-input="nearest"
                                 style="display:flex;width:100%;">
                                <input type="text" class="form-control datetimepicker-input"
                                       data-widget="datetime-picker"
                                       t-att-value="leave_from or ''"
                                       name="leave_from" data-date_format="DD/MM/YYYY" data-widget-type="date"
                                       data-target="#date_leave_from_container" id="leave_from_id"
                                       required="required"/>
                            </div>

                            <div style="margin-top:25px;"></div>

                            <label name="Leave Type" style="font-weight: bold">Date To</label>
                            <div id="date_leave_to_container" data-target-input="nearest"
                                 style="display:flex;width:100%;">
                                <input type="text" data-widget="datetime-picker"
                                       class="form-control datetimepicker-input"
                                       t-att-value="leave_to or ''"
                                       name="leave_to" data-datepicker-format="YYYY-MM-DD" data-widget-type="date"
                                       data-target="#date_leave_to_container" id="leave_to_id"
                                       required="required"/>
                            </div>

                            <div style="margin-top:25px;"></div>

                            <label name="Reason" style="font-weight: bold">Reason</label>
                            <input type="text" class="form-control" t-att-value="reason" name="reason"
                                   required="required"/>

                            <div style="margin-top:50px;"></div>


                            <div>
                                <button type="submit" role="button" class="btn btn-success"
                                        style="align-item:center;font-weight: bold">
                                    <i class='fa fa-check'></i>
                                    Apply
                                </button>
                            </div>
                        </form>

                    </div>
                    <div class="col-6 text-center" style="float:right;justify-content:center;">
                        <a role="button" t-attf-href="/my/leaves" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To Time off
                            Page
                        </a>
                    </div>
                </section>
            </div>



        </t>
    </template>
    <template id="new_leave_success" name="New Leave Success">
        <t t-call="portal.portal_layout">
            <div class="container oe_main" style="text-align:center;max-width: 800px;">
                <img src="/vit_employee_self_service_portal/static/src/img/done.png" width="90"
                     height="90" style="max-width: 90px; max-height: 90px;">
                </img>
                <br/>
                <br/>
                <h2>Thank You</h2>
                <hr/>
                <h4>Your Request Has been successfully created</h4>

            </div>
            <div class="col-12 text-center" style="text-align: center;margin:16px;">
                <a role="button" t-attf-href="/my/leaves" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To Time off Page</a>
            </div>
        </t>
    </template>
    <template id="request_details_page" name="request_details">

        <t t-call="portal.portal_layout">

            <h2 class="text-center">Time Off Details</h2>
            <!--  -->
            <div style="margin-right:400px; margin-left:400px; margin-top:20px;">
                <table class="table">
                    <tr>
                        <th style="width:80%; font-weight: bold;">Allocated</th>
                        <th style="width:20%; font-weight: bold;text-align: center;"><t t-out="allocated"/></th>
                    </tr>
                    <tr>
                        <th style="width:80%; font-weight: bold;">Accrual</th>
                        <th style="width:20%; font-weight: bold;text-align: center;"><t t-out="accrual"/></th>
                    </tr>
                    <tr>
                        <th style="width:80%; font-weight: bold;">Approved</th>
                        <th style="width:20%; font-weight: bold;text-align: center;"><t t-out="approved"/></th>
                    </tr>
                    <tr>
                        <th style="width:80%; font-weight: bold;">Planned</th>
                        <th style="width:20%; font-weight: bold;text-align: center;"><t t-out="planned"/></th>
                    </tr>
                    <tr>
                        <th style="width:80%; font-weight: bold;">Available</th>
                        <th style="width:20%; font-weight: bold;text-align: center;"><t t-out="available"/></th>
                    </tr>
                </table>
            </div>
            <!--  -->
            <div class="col-12 text-center" style="text-align: center;margin:16px;">
                <a role="button" t-attf-href="/my/leaves" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To Time Off Page</a>
            </div>
        </t>



    </template>
</odoo>
