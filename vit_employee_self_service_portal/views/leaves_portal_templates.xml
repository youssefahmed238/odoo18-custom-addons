<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_menu_leaves" name="Portal layout : Leaves menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li id="portal_breadcrumbs_attendance"
                t-if="page_name == 'leave' or leave"
                t-attf-class="breadcrumb-item #{'active ' if not leave else ''}">
                <a t-if="leave" t-attf-href="/my/leaves?{{ keep_query() }}">Time Off</a>
                <t t-else="">Time Off</t>
            </li>
            <li t-if="leave" class="breadcrumb-item active">
                <t t-out="leave.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_leaves" name="Show Leaves of Employee" customize_show="True"
              inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry" t-if="partner.employee_ids">
                <t t-set="icon" t-value="'/hr_holidays/static/description/icon.png'"/>
                <t t-set="title">Time Off</t>
                <t t-set="url" t-value="'/my/leaves'"/>
                <t t-set="text">Follow, view your Time off logs</t>
                <t t-set="placeholder_count" t-value="'leaves_count'"/>
            </t>
        </div>
    </template>

<!--========================================-->

    <template id="portal_my_leaves" name="My Leaves/Time Off">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Time Off</t>
            </t>

            <h4><img src="/hr_holidays/static/description/icon.png" height="40px" width="40px"/>
                My Time Off
            </h4>
            <t t-if="not leaves">
                <p>There are currently no Requests / Time Off for your account.</p>
            </t>

            <div style="margin-right:400px; margin-left:400px; margin-top:20px;">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:80%; font-weight: bold;">Time Off Type #</th>
                            <th style="width:20%; font-weight: bold;text-align: center;">DAYS</th>
                        </tr>
                    </thead>
                    <t t-foreach="paid_time_off" t-as="paid">
                        <tr>
                            <td>
                                <a t-attf-href="/my/timeoff/#{paid.holiday_status_id.id}">
                                    <i class="fa fa-calendar"
                                       style="color: #590046;font-size:15px; margin-right:10px;"/>
                                    <t t-out="paid.holiday_status_id.name"/>
                                </a>
                            </td>
                            <td style="text-align: center;">
                                <t t-out="paid.number_of_days_display"/>
                            </td>
                        </tr>
                    </t>
                </table>


            </div>

            <div style="margin-top:50px;">

            </div>
            <t t-if="leaves" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th class="text-left">Employee</th>
                        <th>
                            <span class='d-none d-md-inline'>Time Off Type #</span>
                            <span class='d-block d-md-none'>Ref.</span>
                        </th>
                        <th class="text-left">Date From</th>
                        <th class="text-left">Date To</th>
                        <th class="text-right">Duration</th>
                        <th class="text-right">Description</th>
                        <th class="text-right">Status</th>
                        <th class="text-right"></th>
                    </tr>
                </thead>
                <t t-foreach="leaves" t-as="leave">
                    <tr>
                        <td class="text-left">
                            <a t-att-href="leave.get_portal_url()">
                                <t t-esc="employee_id.name"/>
                            </a>
                        </td>
                        <td>
                            <a t-att-href="leave.get_portal_url()">
                                <t t-esc="leave.holiday_status_id.name"/>
                            </a>
                        </td>
                        <td class="text-left">
                            <a t-att-href="leave.get_portal_url()">
                                <span t-field="leave.request_date_from"
                                      t-options="{'widget': 'date'}"/>
                            </a>
                        </td>
                        <td class="text-left">
                            <a t-att-href="leave.get_portal_url()">
                                <span t-field="leave.request_date_to" t-options="{'widget': 'date'}"/>
                            </a>
                        </td>
                        <td class="text-right">
                            <span t-field="leave.number_of_days"/>
                            Days
                        </td>
                        <td class="text-right">
                            <span t-field="leave.private_name" style="white-space: normal; word-wrap: break-word;"/>
                        </td>
                        <td class="text-right">
                            <span t-field="leave.state"/>
                        </td>
                        <td class="text-right">
                            <a t-if="leave.state not in ['refuse','validate1','validate']" role="button"
                               title="edit leave" id="edit_leave" t-attf-href="/edit_leave/#{leave.id}"
                               class="btn btn-info btn-lg">
                                <i class="fa fa-edit" style="color: white;"/>
                            </a>
                        </td>
                    </tr>
                </t>
            </t>
            <br/>
            <br/>
            <div class="col-12">
                <div class="col-6 text-center" style="float:left;justify-content:center;">
                    <a role="button" t-attf-href="/request_new_leave" class="btn btn btn-info btn-lg" style="font-weight: bold">New
                        Request
                    </a>
                </div>
                <div class="col-6 text-center" style="float:right;justify-content:center;">
                    <a role="button" t-attf-href="/my" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To
                        Home Page
                    </a>
                </div>
            </div>
            <br/>
            <br/>
        </t>
    </template>
    <template id="portal_my_leave" name="Leave Portal Template" inherit_id="portal.portal_sidebar"
              primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="o_portal_fullwidth_alert" groups="hr_payroll.group_hr_payroll_manager">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/web#model=%s&amp;id=%s&amp;action=%s&amp;view_type=form' % (leave._name, leave.id, leave.env.ref('hr_holidays.hr_leave_action_action_approve_department').id)"/>
                </t>
            </t>

            <div class="row mt16 o_portal_payslip_sidebar">

                <!-- Page content -->
                <div id="leave_content" class="o_portal_content col-12 col-lg-9 col-xl-8">
                    <div t-if="leave.state == 'refuse'"
                         class="alert alert-danger alert-dismissable d-print-none"
                         role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="close">
                            &amp;times;
                        </button>
                        <strong>This Request has been rejected.</strong>
                    </div>
                    <div t-attf-class="card #{'pb-5' if report_type == 'html' else ''}"
                         id="portal_leave_content">
                        <div t-call="vit_employee_self_service_portal.leave_portal_content"/>
                    </div>
                    <!-- chatter -->
                    <div id="leave_communication" class="mt-4">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread"/>
                    </div>
                </div>

            </div>
            <div class="col-12 text-center" style="text-align: center;margin:16px;">
                <a role="button" t-attf-href="/my" class="btn btn-danger btn-lg" style="font-weight: bold">Go Back To Home
                    Page
                </a>
            </div>
        </xpath>
    </template>
    <template id="leave_portal_content" name="Leave Portal Content">
        <!-- Intro -->
        <div id="introduction"
             t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}">
            <h2 class="my-0">
                <span>Request Type:</span>
                <em t-esc="leave.holiday_status_id.name"/>
            </h2>
        </div>

        <div t-attf-class="#{'card-body' if report_type == 'html' else ''}">
            <!-- Informations -->
            <div id="informations">
                <div class="row" style="font-size:18px;">
                    <div class="mb-3 col-9">
                        <strong>Request Period:</strong>
                        <span
                                t-field="leave.request_date_from" t-options='{"widget": "date"}'/>
                        -
                        <span
                                t-field="leave.request_date_to" t-options='{"widget": "date"}'/>
                    </div>
                </div>
            </div>
            <section id="details" style="page-break-inside: auto;" class="mt32">
                <h3 id="details">Request Information</h3>
                <div class="row">
                    <div class="col-6">
                        <span>Duration:</span>
                        <span t-esc="leave.number_of_days"/>
                        - Days
                    </div>
                    <div class="col-6">
                        <span>Department:</span>
                        <span t-esc="leave.department_id.name"/>
                    </div>
                </div>
                <br/>
                <div class="row">
                    <div class="col-6">
                        <span>Notes:</span>
                        <p t-esc="leave.private_name"/>
                        <br/>
                        <span t-esc="leave.notes"/>
                    </div>
                </div>
            </section>
        </div>

    </template>

