<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="motor_risks_form_view">
            <field name="name">motor.risks.form.view</field>
            <field name="model">motor.risks</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="policy_number" readonly="state != 'draft'" />
                                <field name="name" readonly="state != 'draft'" />

                            </group>
                            <group>

                            </group>
                        </group>

                         <notebook>
                            <page name="life_cover" string="Cover">
                                <field name="cover_risks_ids">
                                    <list editable="bottom">
                                        <field name="currency" readonly="parent.state != 'draft'"/>
                                        <field name="cover" readonly="parent.state != 'draft'"/>
                                        <field name="si_before" readonly="parent.state != 'draft'"/>
                                        <field name="si_now" readonly="parent.state != 'draft'"/>
                                        <field name="rate" readonly="parent.state != 'draft'"/>
                                        <field name="premium" readonly="parent.state != 'draft'"/>
                                    </list>
                                </field>
                            </page>


                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="motor_risks_list_view">
            <field name="name">motor.risks.list.view</field>
            <field name="model">motor.risks</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="motor_risks_search_view">
            <field name="name">motor.risks.search</field>
            <field name="model">motor.risks</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_motor_risks" model="ir.actions.act_window">
            <field name="name">Motor Risks</field>
            <field name="res_model">motor.risks</field>
            <field name="view_mode">list,form</field>
            <field name="help">Motor risks list.</field>
        </record>


        <menuitem id="menu_item_motor_risks" name="Motor Risks" parent="menu_item_motor"
              action="action_motor_risks"/>

    </data>
</odoo>