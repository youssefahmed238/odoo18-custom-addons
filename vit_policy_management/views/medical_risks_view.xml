<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="medical_risk_form_view">
            <field name="name">medical.risk.form.view</field>
            <field name="model">policy.medical.risks</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>

                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="medical_risk_list_view">
            <field name="name">medical.risk.list.view</field>
            <field name="model">policy.medical.risks</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="medical_risk_search_view">
            <field name="name">medical.risk.search</field>
            <field name="model">policy.medical.risks</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_medical_risk" model="ir.actions.act_window">
            <field name="name">Medical Risks</field>
            <field name="res_model">policy.medical.risks</field>
            <field name="view_mode">list,form</field>
            <field name="help">Medical risks list.</field>
        </record>


        <menuitem id="menu_item_medical_risks" name="Medical Risks" parent="menu_item_medical"
              action="action_medical_risk"/>

    </data>
</odoo>