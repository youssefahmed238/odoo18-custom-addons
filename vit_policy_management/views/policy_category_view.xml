<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="policy_category_form_view">
        <field name="name">policy.category.form.view</field>
        <field name="model">policy.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>

                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="policy_category_list_view">
        <field name="name">policy.category.list.view</field>
        <field name="model">policy.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="policy_category_search_view">
        <field name="name">policy.category.search</field>
        <field name="model">policy.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_policy_category" model="ir.actions.act_window">
        <field name="name">Policy Category</field>
        <field name="res_model">policy.category</field>
        <field name="view_mode">list,form</field>
        <field name="help">Policy Category list.</field>
    </record>

    <menuitem id="menu_policy_configuration"
              parent="menu_policy_management" name="Configuration"
              sequence="400"/>

    <menuitem id="menu_item_policy_category" name="Policy Category" parent="menu_policy_configuration"
              action="action_policy_category" sequence="10"/>


</odoo>