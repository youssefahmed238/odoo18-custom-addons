<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="policy_risks_form_view">
            <field name="name">policy.risks.form.view</field>
            <field name="model">policy.risks</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="state != 'draft'"/>

                                <field name="category" readonly="state != 'draft'"/>

                                <field name="category_code" invisible="1"/>

                                <field name="medical_policy_number" readonly="state != 'draft'" invisible="category_code != 'Medical'"/>
                                <field name="life_policy_number" readonly="state != 'draft'" invisible="category_code != 'Life'"/>
                                <field name="motor_policy_number" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="fire_policy_number" readonly="state != 'draft'" invisible="category_code != 'Fire'"/>
                                <field name="eng_policy_number" readonly="state != 'draft'" invisible="category_code != 'Engineering'"/>
                                <field name="misc_policy_number" readonly="state != 'draft'" invisible="category_code != 'MISC'"/>

                            </group>

                            <group>

                            </group>

                            <group string="car Details" invisible="category_code != 'Motor'">
                                <field name="possession" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="plate_number" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="maker" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="model" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="color" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="number_of_seats" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="year" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="body_type" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="usage" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="cc" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="chassis_number" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="engine_number" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="fuel_type" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="radio" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="air_conditioner" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>
                                <field name="road_side" readonly="state != 'draft'" invisible="category_code != 'Motor'"/>


                            </group>
                        </group>




                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="policy_risks_list_view">
            <field name="name">policy.risks.list.view</field>
            <field name="model">policy.risks</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="policy_risks_search_view">
            <field name="name">policy.risks.search</field>
            <field name="model">policy.risks</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_policy_risks" model="ir.actions.act_window">
            <field name="name">Policy risks</field>
            <field name="res_model">policy.risks</field>
            <field name="view_mode">list,form</field>
            <field name="help">policy risks list.</field>
        </record>

        <menuitem id="menu_policy_management" name="Policy Management" sequence="10"/>

        <menuitem id="menu_item_risks" name="Risks" parent="menu_policy_management"
                  action="action_policy_risks"/>

    </data>
</odoo>