<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="fire_risks_form_view">
            <field name="name">fire.risks.form.view</field>
            <field name="model">fire.risks</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>

                            </group>
                        </group>


<!--                        <notebook>-->
<!--                            <page name="cover" string="Covers">-->
<!--                                <field name="cover_line_id">-->
<!--                                    <list>-->
<!--                                        <field name="curr"/>-->
<!--                                        <field name="cover"/>-->
<!--                                        <field name="si_now"/>-->
<!--                                        <field name="rate"/>-->
<!--                                        <field name="net_premium"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </page>-->
<!--                        </notebook>-->

                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="fire_risks_list_view">
            <field name="name">fire.risks.list.view</field>
            <field name="model">fire.risks</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="fire_risks_search_view">
            <field name="name">fire.risks.search</field>
            <field name="model">fire.risks</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_fire_risks" model="ir.actions.act_window">
            <field name="name">Fire Risks</field>
            <field name="res_model">fire.risks</field>
            <field name="view_mode">fire,form</field>
            <field name="help">Life risks list.</field>
        </record>


        <menuitem id="menu_item_fire_risks" name="Fire Risks" parent="menu_item_fire"
              action="action_fire_risks"/>

    </data>
</odoo>