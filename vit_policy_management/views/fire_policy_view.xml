<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="fire_policy_form_view">
            <field name="name">fire.policy.form.view</field>
            <field name="model">fire.policy</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="create_sub_fire_policy" string="Create Sub Policy" type="object"
                                class="oe_highlight" invisible="state in ['cancel']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_parent_policy"
                                    icon="fa-shield" invisible="not parent_id">
                                Parent Policy
                            </button>

                            <button class="oe_stat_button" type="object" name="action_view_child_policies"
                                    icon="fa-list" invisible="child_count == 0">
                                <field string="Sub Policies" name="child_count" widget="statinfo"/>
                            </button>
                        </div>

                        <group>
                            <field name="name"/>
                            <group>
                                <field name="policy_number"/>
                                <field name="sum_insured"/>
                                <field name="current"/>
                                <field name="ifrs_group_name"/>
                                <field name="ifrs_group_code"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="fire_policy_list_view">
            <field name="name">fire.policy.list.view</field>
            <field name="model">fire.policy</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="fire_policy_search_view">
            <field name="name">fire.policy.search</field>
            <field name="model">fire.policy</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_fire_policy" model="ir.actions.act_window">
            <field name="name">Fire Policy</field>
            <field name="res_model">fire.policy</field>
            <field name="view_mode">list,form</field>
            <field name="help">Fire Policy list.</field>
        </record>

        <menuitem id="menu_item_fire" name="Fire" parent="menu_policy_management"
                  sequence="2"/>

        <menuitem id="menu_item_fier_policy" name="Policy" parent="menu_item_fire"
                  action="action_fire_policy" sequence="3"/>


    </data>
</odoo>