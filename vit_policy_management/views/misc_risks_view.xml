<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="misc_risks_form_view">
            <field name="model">misc.risks</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>

                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="misc_risks_list_view">
            <field name="name">misc.risks.list.view</field>
            <field name="model">misc.risks</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="misc_risks_search_view">
            <field name="name">misc.risks.search</field>
            <field name="model">misc.risks</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_misc_risks" model="ir.actions.act_window">
            <field name="name">Misc Risks</field>
            <field name="res_model">misc.risks</field>
            <field name="view_mode">list,form</field>
            <field name="help">Misc risks list.</field>
        </record>


        <menuitem id="menu_item_misc_risks" name="Misc Risks" parent="menu_item_misc"
              action="action_misc_risks"/>

    </data>
</odoo>