<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="policy_product_form_view">
        <field name="name">policy.product.form.view</field>
        <field name="model">policy.product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                        </group>
                        <group>

                        </group>
                    </group>
                </sheet>

            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="policy_product_list_view">
        <field name="name">policy.product.list.view</field>
        <field name="model">policy.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>


    <record model="ir.ui.view" id="policy_product_search_view">
        <field name="name">policy.product.search</field>
        <field name="model">policy.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
            </search>
        </field>
    </record>


    <record id="action_policy_product" model="ir.actions.act_window">
        <field name="name">Policy Product</field>
        <field name="res_model">policy.product</field>
        <field name="view_mode">list,form</field>
        <field name="help">Policy Product list.</field>
    </record>
    <menuitem id="menu_item_policy_product" name="Policy Product" parent="menu_policy_configuration"
              action="action_policy_product" sequence="11"/>


</odoo>