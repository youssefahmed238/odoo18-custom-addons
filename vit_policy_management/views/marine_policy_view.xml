<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="marine_policy_form_view">
            <field name="name">marine.policy.form.view</field>
            <field name="model">marine.policy</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <group>
                            <field name="name"/>
                            <group>
                                <field name="policy_number"/>
                                <field name="sum_insured"/>
                                <field name="current"/>
                                <field name="ifrs_group_name"/>
                                <field name="ifrs_group_code"/>
                            </group>
                            <group>

                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="marine_policy_list_view">
            <field name="name">marine.policy.list.view</field>
            <field name="model">marine.policy</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="marine_policy_search_view">
            <field name="name">marine.policy.search</field>
            <field name="model">marine.policy</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_marine_policy" model="ir.actions.act_window">
            <field name="name">Marine Policy</field>
            <field name="res_model">marine.policy</field>
            <field name="view_mode">list,form</field>
            <field name="help">Marine Policy list.</field>
        </record>


        <menuitem id="menu_item_marine" name="Marine" parent="menu_policy_management"
                  sequence="2"/>

        <menuitem id="menu_item_marine_policy" name="Policy" parent="menu_item_marine"
                  action="action_marine_policy" sequence="3"/>



    </data>
</odoo>