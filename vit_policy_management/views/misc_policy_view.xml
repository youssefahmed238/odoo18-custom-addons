<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.ui.view" id="misc_policy_form_view">
            <field name="name">misc.policy.form.view</field>
            <field name="model">misc.policy</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="set_to_draft" string="Set to Draft" type="object" class="oe_highlight"
                                state="draft" invisible="state in ['draft' , 'approved']"/>

                        <button name="set_to_cancel" string="Cancel" type="object" state="cancel"
                                invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="set_to_approved" string="Approved" type="object" class="oe_highlight"
                                state="approved" invisible="state in ['approved', 'cancel', 'delivered']"/>

                        <button name="create_sub_misc_policy" string="Create Sub Policy" type="object"
                                class="oe_highlight" invisible="state not in ['approved'] or parent_id"/>

                        <field name="state" widget="statusbar" statusbar_visible="cancel,draft,approved"
                               readonly="1"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" name="action_view_parent_policy"
                                    icon="fa-shield" invisible="not parent_id">
                                Parent Policy
                            </button>

                            <button class="oe_stat_button" type="object" name="action_view_child_policies"
                                    icon="fa-list" invisible="child_count == 0">
                                <field string="Sub Policies" name="child_count" widget="statinfo"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <h3>
                                <field name="name"/>
                            </h3>
                        </div>

                        <group>
                            <group>
                                <field name="create_date"/>
                                <field name="sum_insured" readonly="state != 'draft'" />
                                <field name="current" readonly="state != 'draft'" />
                                <field name="ifrs_group_name" readonly="state != 'draft'" />
                                <field name="ifrs_group_code" readonly="state != 'draft'" />
                                <field name="create_by"/>
                            </group>
                            <group>
                            </group>
                        </group>

                        <notebook>
                            <page name="policy_basic_info" string="Policy Basic Info">
                                <group>
                                    <group>
                                        <field name="insurer" readonly="state != 'draft'" />
                                        <field name="product" readonly="state != 'draft'" />
                                        <field name="customer" readonly="state != 'draft'" />
                                        <field name="business_source_id" readonly="state != 'draft'" />
                                        <field name="in_favor" readonly="state != 'draft'" />
                                        <field name="kay_account" readonly="state != 'draft'" />
                                        <field name="branch" readonly="state != 'draft'" />
                                        <field name="transaction_type" readonly="state != 'draft'" />
                                        <field name="parent" readonly="state != 'draft'" />
                                        <field name="invoice" readonly="state != 'draft'" />
                                        <field name="approved_by" readonly="state != 'draft'" />
                                        <field name="approved_only" readonly="state != 'draft'" />
                                    </group>
                                    <group>
                                        <field name="curr" readonly="state != 'draft'" />
                                        <field name="calculation_type" readonly="state != 'draft'" />
                                        <field name="issue_date" readonly="state != 'draft'" />
                                        <field name="effective_date_from" readonly="state != 'draft'" />
                                        <field name="effective_date_to" readonly="state != 'draft'" />
                                        <field name="period_in_days" readonly="state != 'draft'" />
                                        <field name="version" readonly="state != 'draft'" />
                                        <field name="next_version_date" readonly="state != 'draft'" />
                                        <field name="dayes_torenewal" readonly="state != 'draft'" />
                                        <field name="loss_rate" readonly="state != 'draft'" />
                                        <field name="renewal_loss_ratio" readonly="state != 'draft'" />
                                    </group>
                                </group>
                            </page>

                            <page name="risk_details" string="Risk Details">


                            </page>


                            <page name="policy_financial" string="Policy Financial">
                                <group>
                                    <group>
                                        <field name="net_premium" readonly="state != 'draft'" />
                                        <field name="net_premium_egp" readonly="state != 'draft'" />
                                        <field name="reg_premium" readonly="state != 'draft'" />
                                        <field name="payment_on" readonly="state != 'draft'" />
                                        <field name="payment_freq" readonly="state != 'draft'" />
                                        <field name="years" readonly="state != 'draft'" />
                                        <field name="create_certificate_puc" readonly="state != 'draft'" />

                                    </group>
                                    <group>
                                        <field name="gross_premium" readonly="state != 'draft'" />
                                        <field name="gross_premium_egp" readonly="state != 'draft'" />
                                        <field name="gross_rate" readonly="state != 'draft'" />

                                    </group>
                                </group>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="misc_policy_list_view">
            <field name="name">misc.policy.list.view</field>
            <field name="model">misc.policy</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record model="ir.ui.view" id="misc_policy_search_view">
            <field name="name">misc.policy.search</field>
            <field name="model">misc.policy</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <record id="action_misc_policy" model="ir.actions.act_window">
            <field name="name">MISC Policy</field>
            <field name="res_model">misc.policy</field>
            <field name="view_mode">list,form</field>
            <field name="help">MISC Policy list.</field>
        </record>

        <menuitem id="menu_item_misc" name="MISC" parent="menu_policy_management"
                  sequence="2"/>

        <menuitem id="menu_item_engineering_policy" name="Policy" parent="menu_item_misc"
                  action="action_misc_policy" sequence="3"/>

    </data>
</odoo>