<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!-- Category -->
    <record model="ir.module.category" id="module_category_add_petty_functionality">
        <field name="name">Petty Management</field>
    </record>

    <!-- Employee (lowest level) -->
    <record id="group_petty_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="add_petty_functionality.module_category_add_petty_functionality"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Make Employee the default petty group for all new internal users -->
<!--    <record id="base_user_group_inherit" model="res.groups">-->
<!--        <field name="implied_ids" eval="[(4, ref('add_petty_functionality.group_petty_employee'))]"/>-->
<!--        <field name="id" ref="base.group_user"/>-->
<!--    </record>-->

    <!-- Branch Accountant (inherits Employee) -->
    <record id="group_petty_branch_accountant" model="res.groups">
        <field name="name">Branch Accountant</field>
        <field name="category_id" ref="add_petty_functionality.module_category_add_petty_functionality"/>
        <field name="implied_ids" eval="[(4, ref('add_petty_functionality.group_petty_employee'))]"/>
    </record>

    <!-- Account Manager (inherits Branch Accountant + Employee) -->
    <record id="group_petty_account_manager" model="res.groups">
        <field name="name">Account Manager</field>
        <field name="category_id" ref="add_petty_functionality.module_category_add_petty_functionality"/>
        <field name="implied_ids" eval="[
            (4, ref('add_petty_functionality.group_petty_branch_accountant')),
            (4, ref('add_petty_functionality.group_petty_employee'))
        ]"/>
    </record>

</data>
</odoo>