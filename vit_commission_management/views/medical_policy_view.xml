<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  Add commission lines to medical policy form view  -->
    <record id="view_medical_policy_form_inherit_commission" model="ir.ui.view">
        <field name="name">medical.policy.form.inherit.commission</field>
        <field name="model">medical.policy</field>
        <field name="inherit_id" ref="vit_policy_management.medical_policy_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='policy_financial']" position="inside">
                <group>
                    <field name="apply_commission"/>
                </group>
                <group string="Company Commission">
                    <field name="commission_line_ids" readonly="apply_commission" nolabel="1">
                        <list editable="bottom">
                            <field name="basic_p" readonly="apply_commission"/>
                            <field name="comp_p" readonly="apply_commission"/>
                            <field name="transportation_comm_p" readonly="apply_commission"/>
                            <field name="bonus_p" readonly="apply_commission"/>
                            <field name="commission_p" readonly="apply_commission"/>

                            <field name="layer_1_p" readonly="apply_commission"/>
                            <field name="layer_2_p" readonly="apply_commission"/>
                            <field name="layer_3_p" readonly="apply_commission"/>
                            <field name="layer_4_p" readonly="apply_commission"/>

                            <field name="basic"/>
                            <field name="comp"/>
                            <field name="transportation_comm"/>
                            <field name="bonus"/>
                            <field name="commission"/>

                            <field name="total_amount"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>