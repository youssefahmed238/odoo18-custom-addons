<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  Add commission lines to fire policy form view  -->
    <record id="view_fire_policy_form_inherit_commission" model="ir.ui.view">
        <field name="name">fire.policy.form.inherit.commission</field>
        <field name="model">fire.policy</field>
        <field name="inherit_id" ref="vit_policy_management.fire_policy_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook/page[@name='policy_financial']" position="inside">
                 <group string="Company Commission">
                    <group>
                        <group>
                            <field name="apply_commission"/>
                        </group>
                        <group>
                            <field name="total_amount" invisible="apply_commission"/>
                            <field name="total_amount_p" invisible="apply_commission"/>
                        </group>
                    </group>
                    <field name="commission_line_ids" readonly="1" nolabel="1" invisible="not apply_commission">
                        <list editable="bottom">
                            <field name="basic_p"/>
                            <field name="comp_p"/>
                            <field name="transportation_comm_p"/>
                            <field name="bonus_p"/>
                            <field name="commission_p"/>

                            <field name="layer_1_p"/>
                            <field name="layer_2_p"/>
                            <field name="layer_3_p"/>
                            <field name="layer_4_p"/>

                            <field name="basic"/>
                            <field name="comp"/>
                            <field name="transportation_comm"/>
                            <field name="bonus"/>
                            <field name="commission"/>

                            <field name="total_amount"/>
                            <field name="total_amount_p"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>