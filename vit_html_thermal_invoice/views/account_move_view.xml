<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the account.move form view to add print thermal invoice button -->
    <record id="view_move_form_inherit_thermal_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.thermal.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="print_invoice_thermal_report" type="object"
                        invisible="not using_thermal_printer">
                    <img src="/vit_html_thermal_base/static/src/icons/print_thermal.png"
                         style="height:24px; width:24px; margin-right:5px;"/>
                    <tspan>Print Thermal Invoice</tspan>
                </button>
            </xpath>
        </field>
    </record>

</odoo>