                                        </th>
                                        <th style="text-align: center;">
                                            <span>السعر شامل الضريبة</span>
                                            <!--                                            <span>Amount</span>-->
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="current_section" t-value="None"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                    <t t-set="current_total" t-value="0"/>
                                    <t t-set="line_sequence" t-value="1"/>

                                    <t t-foreach="lines" t-as="line">
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                                        <t t-set="current_total" t-value="current_total + line.price_total"/>

                                        <tr t-att-class="'fw-bold' if line.display_type == 'line_section' else 'fst-italic' if line.display_type == 'line_note' else ''">

                                            <!-- Product Line -->
                                            <t t-if="line.display_type == 'product'">
                                                <!-- Sequence Column -->
                                                <td style="text-align: center;">
                                                    <span t-esc="line_sequence"/>
                                                    <t t-set="line_sequence" t-value="line_sequence + 1"/>
                                                </td>

                                                <!-- Product Column -->
                                                <td style="word-wrap: break-word; white-space: normal;">
                                                    <span t-if="line.name" t-field="line.name"
                                                          t-options="{'widget': 'text'}"/>
                                                </td>

                                                <!-- Quantity Column -->
                                                <td style="text-align: center;">
                                                    <span t-field="line.quantity"/>
                                                    <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                                </td>

                                                <!-- Price Column -->
                                                <td style="text-align: center; white-space: nowrap; font-size: 9px;">
                                                    <span t-field="line.price_unit"/>
                                                </td>

                                                <!--                                                &lt;!&ndash; Discount Column &ndash;&gt;-->
                                                <!--                                                <td t-if="display_discount"-->
                                                <!--                                                    style="text-align: center; white-space: nowrap; font-size: 9px;">-->
                                                <!--                                                    <span t-field="line.discount"/>-->
                                                <!--                                                </td>-->
                                                <!-- Tax Column -->
                                                <td style="text-align: center; white-space: nowrap; font-size: 9px;">
                                                    <span t-esc="'%.2f' % ((line.price_total - line.price_subtotal) / line.quantity if line.quantity else 0)"/>
                                                </td>

                                                <!-- Subtotal Column -->
                                                <td style="text-align: center; font-weight: bold; white-space: nowrap; font-size: 9px;">
                                                    <span t-field="line.price_subtotal"/>
                                                </td>
                                            </t>

                                            <!-- Section Line -->
                                            <t t-elif="line.display_type == 'line_section'">
                                                <td colspan="99"
                                                    style="font-weight: bold; padding-top: 5px; word-wrap: break-word; white-space: normal;">
                                                    <span t-if="line.name" t-field="line.name"
                                                          t-options="{'widget': 'text'}"/>
                                                </td>
                                                <t t-set="current_section" t-value="line"/>
                                                <t t-set="current_subtotal" t-value="0"/>
                                            </t>

                                            <!-- Note Line -->
                                            <t t-elif="line.display_type == 'line_note'">
                                                <td colspan="99"
                                                    style="font-style: italic; font-size: 9px; word-wrap: break-word; white-space: normal;">
                                                    <span t-if="line.name" t-field="line.name"
                                                          t-options="{'widget': 'text'}"/>
                                                </td>
                                            </t>
                                        </tr>

                                        <!-- Section Subtotal -->
                                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                            <tr style="font-weight: bold; border-top: 1px solid #000;">
                                                <td colspan="99" style="text-align: right; padding: 5px 2px;">
                                                    <strong style="margin-right: 10px;">Subtotal</strong>
                                                    <span t-out="current_subtotal"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                            <t t-set="current_section" t-value="None"/>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>

