                        <div class="thermal-section">
                            <table class="thermal-table" style="direction: rtl;text-align: right;">
                                <thead>
                                    <tr>
                                        <th style="text-align: center; width: 3%;">#</th>
                                        <th style="text-align: right; width: 20%;">
                                            <span>الصنف</span>
                                            <!--                                            <span>Desc</span>-->
                                        </th>
                                        <th style="text-align: center; width: 15%;">
