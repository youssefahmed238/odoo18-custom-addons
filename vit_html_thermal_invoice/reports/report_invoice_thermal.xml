                                            <!--                                            <span>Qty</span>-->
                                        </th>
                                        <th style="text-align: center; width: 15%;">
                                            <span>السعر</span>
                                            <!--                                            <span>Price</span>-->
                                        </th>
                                        <th style="text-align: center; width: 12%;">
