                        <!--                                    </span>-->
                        <!--                                </div>-->

                        <!--                                &lt;!&ndash; Total &ndash;&gt;-->
                        <!--                                <div class="thermal-row"-->
                        <!--                                     style="font-weight: bold; font-size: 12px; border-top: 2px solid #000; padding-top: 5px; margin-top: 5px;">-->
                        <!--                                    <strong>Total / المجموع:</strong>-->
                        <!--                                    <strong>-->
                        <!--                                        <t t-out="tax_totals['total_amount_currency']"-->
                        <!--                                           t-options='{"widget": "monetary", "display_currency": currency}'/>-->
                        <!--                                    </strong>-->
                        <!--                                </div>-->
                        <!--                            </t>-->
                        <!--                        </div>-->

                        <!-- Payments (if print_with_payments) -->
                        <div t-if="print_with_payments and o.payment_state != 'invoicing_legacy'"
                             class="thermal-section" style="text-align: right; font-size: 10px;">
                            <t t-set="payments_vals"
                               t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                            <t t-foreach="payments_vals" t-as="payment_vals">
                                <div t-if="payment_vals['is_exchange'] == 0" style="margin: 3px 0;">
                                    <span style="font-style: italic;">
                                        <t t-if="payment_vals['is_refund']">Reversed on / تم الاسترجاع في</t>
                                        <t t-else="">Paid on / تم الدفع في</t>
                                        <t t-out="payment_vals['date']" t-options='{"widget": "date"}'/>
                                    </span>
                                    <span style="margin-left: 10px;">
                                        <t t-out="payment_vals['amount']"
                                           t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </span>
                                </div>
                            </t>
                            <div t-if="len(payments_vals) > 0" style="font-weight: bold; margin-top: 5px;">
                                <span style="margin-right: 10px;">Amount Due / المبلغ المستحق:</span>
                                <span t-field="o.amount_residual"/>
                            </div>
                        </div>

                        <!-- Amount in Words -->
                        <div t-if="o.company_id.display_invoice_amount_total_words"
                             class="thermal-section" style="text-align: center; font-size: 10px;">
                            <div style="font-weight: bold;">Total amount in words / المبلغ الإجمالي كتابةً:</div>
                            <div style="font-style: italic; margin-top: 3px;">
                                <span t-field="o.amount_total_words"/>
                            </div>
                        </div>

                        <!-- Tax Totals in Company Currency -->
                        <div t-if="o.tax_totals.get('display_in_company_currency')"
                             class="thermal-section" style="text-align: right; font-size: 10px;">
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-set="currency" t-value="o.company_currency_id"/>
                            <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']"/>

                            <div style="font-weight: bold; margin-bottom: 5px;">
                                Taxes / الضرائب
                                <span t-field="o.company_currency_id"/>
                            </div>

                            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                                <div style="margin: 2px 0;">
                                    <span style="margin-right: 10px;">
                                        <t t-out="subtotal['name']"/>
                                    </span>
                                    <span>
                                        <t t-out="subtotal['base_amount']"
                                           t-options='{"widget": "monetary", "display_currency": currency}'/>
                                    </span>
                                </div>

                                <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                                    <div style="margin: 2px 0; font-size: 9px;">
                                        <t t-if="same_tax_base or tax_group['display_base_amount'] is None">
                                            <span>
                                                <t t-out="tax_group['group_name']"/>
                                            </span>
                                            <span style="margin-left: 5px;">
                                                <t t-out="tax_group['tax_amount']"
                                                   t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span>
                                                <t t-out="tax_group['group_name']"/>
                                                on / على
                                                <t t-out="tax_group['display_base_amount']"
                                                   t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </span>
                                            <span style="margin-left: 5px;">
                                                <t t-out="tax_group['tax_amount']"
                                                   t-options='{"widget": "monetary", "display_currency": currency}'/>
                                            </span>
                                        </t>
                                    </div>
                                </t>
                            </t>

                            <div style="font-weight: bold; margin-top: 3px; border-top: 1px solid #000; padding-top: 3px;">
                                <span style="margin-right: 10px;">Total / المجموع:</span>
                                <span>
                                    <t t-out="tax_totals['total_amount']"
                                       t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </span>
                            </div>
                        </div>

                        <!-- Fiscal Position Note -->
                        <div t-if="not is_html_empty(o.fiscal_position_id.note)"
                             class="thermal-section" style="text-align: left; font-size: 10px;">
                            <span t-field="o.fiscal_position_id.note"/>
                        </div>

                        <!-- Taxes Legal Notes -->
                        <div t-if="not is_html_empty(o.taxes_legal_notes)"
                             class="thermal-section" style="text-align: left; font-size: 10px;">
                            <span t-field="o.taxes_legal_notes"/>
                        </div>

                        <!-- Payment Terms -->
                        <div t-if="o.invoice_payment_term_id.note"
                             class="thermal-section" style="text-align: left; font-size: 10px;">
                            <span t-field="o.invoice_payment_term_id.note"/>
                        </div>

                        <!-- Payment Term Details -->
                        <div t-if="o.invoice_payment_term_id.display_on_invoice and o.payment_term_details and o.show_payment_term_details"
                             class="thermal-section" style="text-align: left; font-size: 10px;">
                            <t t-set="payment_term_details" t-value="o.payment_term_details"/>

                            <!-- Early Payment Discount -->
                            <div t-if="o._is_eligible_for_early_payment_discount(o.currency_id, o.invoice_date)"
                                 style="margin-bottom: 3px;">
                                <span t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                      t-out="o.invoice_payment_term_id._get_amount_due_after_discount(o.amount_total, o.amount_tax)"/>
                                due if paid before / مستحق إذا تم الدفع قبل
                                <span t-out="o.invoice_payment_term_id._get_last_discount_date_formatted(o.invoice_date)"/>
                            </div>

                            <!-- Installments -->
                            <t t-if="len(payment_term_details) > 1">
                                <t t-foreach="payment_term_details" t-as="term">
                                    <div style="margin: 2px 0;">
                                        <span t-out="term_index + 1"/>
                                        - Installment of / دفعة بمبلغ
                                        <t t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                           t-out="term.get('amount')"/>
                                        due on / مستحق في
                                        <t t-out="term.get('date')"/>
                                    </div>
                                </t>
                            </t>
                        </div>

                        <!-- Payment Communication -->
                        <div t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference"
                             class="thermal-section text-center" style="font-size: 10px;">
                            <div>Payment Communication / مرجع الدفع:
                                <span style="font-weight: bold;" t-field="o.payment_reference"/>
                            </div>
                            <div t-if="o.partner_bank_id" style="margin-top: 2px;">
                                on this account / على هذا الحساب:
                                <span style="font-weight: bold;" t-field="o.partner_bank_id"/>
                            </div>
                        </div>

                        <!-- Terms and Conditions / Narration -->
                        <div t-if="not is_html_empty(o.narration)"
                             class="thermal-section" style="text-align: left; font-size: 10px;">
                            <span t-field="o.narration"/>
                        </div>

                    </div>
                </center>
            </t>
        </template>

    </data>
</odoo>