<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_sale_order_thermal">
            <t t-set="report_type" t-value="'html'"/>
            <t t-if="not thermal_width">
                <t t-set="thermal_width" t-value="user.thermal_size or '80mm'"/>
            </t>

<!--            <script type="text/javascript">-->
<!--                window.onload = function () {-->
<!--                window.print();-->
<!--                };-->
<!--            </script>-->

            <style type="text/css">
                @page {
                size: auto;
                margin: 0 !important;
                }

                .my_container {
                width:
                <t t-esc="thermal_width"/>
                !important;
                }
            </style>

            <t t-foreach="docs" t-as="o">
                <link rel="stylesheet" href="/vit_html_thermal_base/static/src/css/thermal_style.css"/>

                <center class="thermal-report-page">
                    <div class="my_container">

                        <!-- Company Logo and Info -->
                        <div style="width: 45%; margin: 0 auto;">
                            <img t-att-src="'data:image/png;base64,' + o.company_id.logo.decode()"
                                 style="width:100%"/>
                        </div>

                        <div style="font-size: 14px; font-weight: bold;">
                            <t t-esc="o.company_id.name"/>
                        </div>

                        <!-- Document Title -->
                        <div class="thermal-section">
                            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
                            <div style="font-size: 16px; font-weight: bold; margin: 10px 0;">
                                <span t-if="is_proforma">Pro-Forma Invoice # / الفاتورة الأولية # </span>
                                <span t-elif="o.state in ['draft','sent']">Quotation # / عرض السعر # </span>
                                <span t-else="">Order # / طلب الشراء # </span>
                                <span t-field="o.name"/>
                            </div>
                        </div>

                        <!-- Customer Address -->
                        <div class="thermal-section" style="text-align: left;">
                            <div t-field="o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                            <p t-if="o.partner_id.vat" style="margin-top: 3px;">
                                <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                                   t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                                <t t-else="">Tax ID / الرقم الضريبي: </t>
                                <span t-field="o.partner_id.vat"/>
                            </p>
                        </div>

                        <!-- Additional Addresses (Invoice/Shipping) -->
                        <div t-if="o.partner_shipping_id == o.partner_invoice_id and o.partner_invoice_id != o.partner_id or o.partner_shipping_id != o.partner_invoice_id"
                             class="thermal-section" style="text-align: left;">

                            <div class="thermal-label">
                                <t t-if="o.partner_shipping_id == o.partner_invoice_id">
                                    Invoicing and Shipping Address / عنوان الفوترة والشحن
                                </t>
                                <t t-else="">
                                    Invoicing Address / عنوان الفوترة
                                </t>
                            </div>
                            <div t-field="o.partner_invoice_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'
                                 style="font-size: 10px; margin-top: 3px;"/>

                            <div t-if="o.partner_shipping_id != o.partner_invoice_id"
                                 style="margin-top: 8px;">
                                <div class="thermal-label">Shipping Address / عنوان الشحن</div>
                                <div t-field="o.partner_shipping_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}'
                                     style="font-size: 10px; margin-top: 3px;"/>
                            </div>
                        </div>

                        <!-- Document Information -->
                        <div class="thermal-section" style="margin-bottom: 5px;">
                            <div class="thermal-row" t-if="o.client_order_ref">
                                <span class="thermal-label" style="text-align: left;">Your Reference:</span>
                                <span class="thermal-value" t-field="o.client_order_ref"/>
                                <span class="thermal-label" style="text-align: right;">مرجعكم:</span>
                            </div>
                            <div class="thermal-row" style="margin-bottom: 5px;" t-if="o.date_order">
                                <span class="thermal-label" style="text-align: left;">
                                    <t t-if="is_proforma">Issued Date:</t>
                                    <t t-elif="o.state in ['draft', 'sent']">Quotation Date:</t>
                                    <t t-else="">Order Date:</t>
                                </span>
                                <span class="thermal-value" t-field="o.date_order" t-options='{"widget": "date"}'/>
                                <span class="thermal-label" style="text-align: right;">
                                    <t t-if="is_proforma">:تاريخ الإصدار</t>
                                    <t t-elif="o.state in ['draft', 'sent']">:تاريخ عرض السعر</t>
                                    <t t-else="">:  تاريخ الطلب</t>
                                </span>
                            </div>
                            <div class="thermal-row" style="margin-bottom: 5px;" t-if="o.validity_date and o.state in ['draft', 'sent']">
                                <span class="thermal-label" style="text-align: left;">Expiration:</span>
                                <span class="thermal-value" t-field="o.validity_date"/>
                                <span class="thermal-label" style="text-align: right;">:تاريخ الانتهاء</span>
                            </div>
                            <div class="thermal-row" style="margin-bottom: 5px;" t-if="o.user_id.name">
                                <span class="thermal-label" style="text-align: left;">Salesperson:</span>
                                <span class="thermal-value" t-field="o.user_id"/>
                                <span class="thermal-label" style="text-align: right;">:مندوب المبيعات</span>
                            </div>
                        </div>

                        <!-- Order Lines Table -->
                        <t t-set="lines_to_report" t-value="o._get_order_lines_to_report()"/>
                        <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>

                        <div class="thermal-section">
                            <table class="thermal-table">
                                <thead>
                                    <tr>
                                        <th style="text-align: center; width: 3%;">#</th>
                                        <th style="text-align: left; width: 20%">
                                            <span>الوصف</span>
                                            <span>Desc</span>
                                        </th>
                                        <th style="text-align: center; width: 10%">
                                            <span>الكمية</span>
                                            <span>Qty</span>
                                        </th>
                                        <th style="text-align: center; width: 20%">
                                            <span>السعر</span>
                                            <span>Price</span>
                                        </th>
                                        <th t-if="display_discount" style="text-align: center; width: 20%">
                                            <span>الخصم %</span>
                                            <span>Disc %</span>
                                        </th>
                                        <th style="text-align: center;">
                                            <span>الإجمالي</span>
                                            <span>Total</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="current_section" t-value="None"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                    <t t-set="sequence" t-value="1"/>

                                    <t t-foreach="lines_to_report" t-as="line">
                                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>

                                        <tr t-att-class="'fw-bold' if (line.display_type == 'line_section' or line.product_type == 'combo') else 'fst-italic' if line.display_type == 'line_note' else ''">

                                            <!-- Regular Product Line -->
                                            <t t-if="not line.display_type and line.product_type != 'combo'">
                                                <td style="text-align: center;">
                                                    <span t-esc="sequence"/>:
                                                    <t t-set="sequence" t-value="sequence + 1"/>
                                                </td>
                                                <td>
                                                    <span t-field="line.name"/>
                                                </td>
                                                <td style="text-align: right; white-space: normal;">
                                                    <span t-field="line.product_uom_qty"/>
                                                </td>
                                                <td style="text-align: center; white-space: nowrap;">
                                                    <span t-field="line.price_unit"/>
                                                </td>
                                                <td t-if="display_discount" style="text-align: center;">
                                                    <span t-field="line.discount"/>
                                                </td>
                                                <td t-if="not line.is_downpayment"
                                                    style="text-align: center; font-weight: bold; overflow-wrap: anywhere;">
                                                    <span t-field="line.price_subtotal"/>
                                                </td>
                                            </t>

                                            <!-- Section Line -->
                                            <t t-elif="line.display_type == 'line_section' or line.product_type == 'combo'">
                                                <td colspan="99" style="font-weight: bold; padding-top: 5px;">
                                                    <span t-field="line.name"/>
                                                </td>
                                                <t t-set="current_section" t-value="line"/>
                                                <t t-set="current_subtotal" t-value="0"/>
                                            </t>

                                            <!-- Note Line -->
                                            <t t-elif="line.display_type == 'line_note'">
                                                <td colspan="99" style="font-style: italic; font-size: 10px;">
                                                    <span t-field="line.name"/>
                                                </td>
                                            </t>
                                        </tr>

                                        <!-- Section Subtotal -->
                                        <t t-if="current_section and (
                                            line_last
                                            or lines_to_report[line_index+1].display_type == 'line_section'
                                            or lines_to_report[line_index+1].product_type == 'combo'
                                            or (line.combo_item_id and not lines_to_report[line_index+1].combo_item_id)
                                        ) and not line.is_downpayment">
                                            <t t-set="current_section" t-value="None"/>
                                            <tr style="font-weight: bold; border-top: 1px solid #000;">
                                                <td colspan="99" style="text-align: right; padding: 5px 2px;">
                                                    <strong style="margin-right: 10px;">Subtotal / المجموع الفرعي:</strong>
                                                    <span t-out="current_subtotal"
                                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <!-- Tax Totals -->
                        <div class="thermal-section" style="text-align: right;">
                            <t t-set="tax_totals" t-value="o.tax_totals"/>
                            <t t-set="currency" t-value="o.currency_id"/>

                            <t t-call="vit_html_thermal_so.document_tax_totals_thermal"/>
                        </div>

                        <!-- Optional Products (Options) -->
                        <div t-if="o.sale_order_option_ids and o.state in ['draft', 'sent']" class="thermal-section">
                            <t t-set="has_option_discount" t-value="any(option.discount != 0.0 for option in o.sale_order_option_ids)"/>

                            <div class="thermal-label" style="font-size: 14px; font-weight: bold; text-align: left; margin-bottom: 5px;">
                                Optional Products
                            </div>

                            <table class="thermal-table">
                                <thead>
                                    <tr>
                                        <th style="text-align: center; width: 3%;">#</th>
                                        <th style="text-align: left; width: 40%;">Description</th>
                                        <th style="text-align: center; width: 15%">Quantity</th>
                                        <th t-if="has_option_discount" style="text-align: center; width: 15%;">Disc</th>
                                        <th style="text-align: center;">Unit Price</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="option_sequence" t-value="1"/>
                                    <tr t-foreach="o.sale_order_option_ids" t-as="option">
                                        <td style="text-align: center;">
                                            <span t-esc="option_sequence"/>:
                                            <t t-set="option_sequence" t-value="option_sequence + 1"/>
                                        </td>
                                        <td>
                                            <span t-field="option.name"/>
                                        </td>
                                        <td style="text-align: center;">
                                            <span t-field="option.quantity"/>
                                            <span t-field="option.uom_id" groups="uom.group_uom"/>
                                        </td>
                                        <td t-if="has_option_discount" style="text-align: center;">
                                            <strong t-if="option.discount != 0.0" class="text-info">
                                                <t t-out="((option.discount % 1) and '%s' or '%d') % option.discount"/>%
                                            </strong>
                                        </td>
                                        <td style="text-align: center; font-weight: bold;">
                                            <div t-field="option.price_unit"
                                                 t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                                 t-att-style="option.discount and 'text-decoration: line-through' or None"
                                                 t-att-class="option.discount and 'text-danger' or None"/>
                                            <div t-if="option.discount" style="font-size: 10px;">
                                                <t t-out="((1-option.discount / 100.0) * option.price_unit)"
                                                   t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Signature -->
                        <div t-if="o.signature" class="thermal-section" style="text-align: center;">
                            <div class="thermal-label">Signature / التوقيع</div>
                            <div style="margin: 5px 0;">
                                <img t-att-src="image_data_uri(o.signature)" style="max-height: 3cm; max-width: 6cm;"/>
                            </div>
                            <div style="font-size: 10px;">
                                <span t-field="o.signed_by"/>
                            </div>
                        </div>

                        <!-- Order Notes -->
                        <div t-if="o.note" class="thermal-section" style="font-size: 10px;">
                            <div class="thermal-row" style="justify-content: left;">
                                <span class="thermal-label">Order Note / ملاحظة الطلب:</span>
                                <span class="thermal-value" t-field="o.note"/>
                            </div>
                        </div>

                        <!-- Payment Terms -->
                        <div t-if="not is_html_empty(o.payment_term_id.note)"
                             class="thermal-section" style="font-size: 10px;">
                            <div class="thermal-row" style="justify-content: left;">
                                <span class="thermal-label">Payment Terms / شروط الدفع:</span>
                                <span t-field="o.payment_term_id.note"/>
                            </div>
                        </div>

                        <!-- Fiscal Position Note -->
                        <div t-if="o.fiscal_position_id and not is_html_empty(o.fiscal_position_id.sudo().note)"
                             class="thermal-section" style="font-size: 10px;">
                            <div class="thermal-row" style="justify-content: left;">
                                <span class="thermal-label">Fiscal Position Remark / ملاحظة الوضع الضريبي:</span>
                                <span t-field="o.fiscal_position_id.sudo().note"/>
                            </div>
                        </div>

                    </div>
                </center>
            </t>
        </template>

        <template id="document_tax_totals_thermal">
            <t t-set="same_tax_base" t-value="tax_totals['same_tax_base']"/>

            <t t-foreach="tax_totals['subtotals']" t-as="subtotal">
                <div class="thermal-row">
                    <span>
                        <t t-out="subtotal['name']"/>
                    </span>
                    <span class="right">
                        <t t-out="subtotal['base_amount_currency']"
                           t-options='{"widget": "monetary", "display_currency": currency}'/>
                    </span>
                </div>

                <t t-foreach="subtotal['tax_groups']" t-as="tax_group">
                    <div class="thermal-row small">
                        <span>
                            <t t-out="tax_group['group_name']"/>
                        </span>
                        <span class="right">
                            <t t-out="tax_group['tax_amount_currency']"
                               t-options='{"widget": "monetary", "display_currency": currency}'/>
                        </span>
                    </div>
                </t>
            </t>

            <!-- Total Amount -->
            <div class="thermal-row total">
                <strong>Total / المجموع:</strong>
                <strong class="right">
                    <t t-out="tax_totals['total_amount_currency']"
                       t-options='{"widget": "monetary", "display_currency": currency}'/>
                </strong>
            </div>
        </template>

    </data>
</odoo>