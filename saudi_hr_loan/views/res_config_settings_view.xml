<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_eos_form_view" model="ir.ui.view">
        <field name="name">res.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']/block" position="after">
                <block title="Clearance Mandatory for EOS">
                        <div>
                            <div class="o_setting_left_pane">
                                <field name="group_employee_can_request_loan"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="group_employee_can_request_loan"/>
                                <div class="text-muted">
                                    Allow employees to create their own loan.
                                </div>
                            </div>
                        </div>
                </block>
            </xpath>
        </field>
    </record>
    <!-- Inherit Form View to Modify it -->
    <record id="view_hr_payslip_form_pay_loan" model="ir.ui.view">
        <field name="name">view.hr.payslip.form.inherited.pay.loan</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <field name="operation_applied_on_payslip" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='compute_sheet']" position="after">
                <button string="Pay Loan Amount" name="action_pay_loan" type="object" invisible="state in ('draft','verify')"
                        class="oe_highlight"/>
            </xpath>

        </field>
    </record>
</odoo>
