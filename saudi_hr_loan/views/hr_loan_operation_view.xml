<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_operation_tree" model="ir.ui.view">
        <field name="name">hr.loan.operation.tree</field>
        <field name="model">hr.loan.operation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="loan_operation_type"/>
                <field name="effective_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_loan_operation_form" model="ir.ui.view">
        <field name="name">hr.loan.operation.form</field>
        <field name="model">hr.loan.operation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="confirm_loan_operation" string="Confirm" invisible="state != 'draft'" type="object"
                            class="oe_highlight" groups="base.group_user"/>
                    <button name="set_to_cancel" string="Cancel" invisible="state != 'draft'" type="object" groups="base.group_user"/>
                    <button name="waiting_approval_loan_operation" string="Approve" invisible="state != 'confirm'" type="object"
                            class="oe_highlight" groups="hr.group_hr_user"/>
                    <button name="approve_loan_operation" string="Approve" invisible="state != 'open'" type="object"
                            class="oe_highlight" groups="account.group_account_manager"/>
                    <button name="apply_loan_operation" string="Run Manually" type="object" class="oe_highlight"
                            groups="account.group_account_manager" context="{'run_manually': True}"
                            invisible = "'|','|', state != 'approve', operation_applied == True , loan_operation_type not in ['increase_amount', 'loan_payment']"/>
                    <button name="refuse_loan_operation" string="Refuse" invisible="state != ('open','confirm')"
                            groups="hr.group_hr_user,account.group_account_manager"
                            type="object"/>
                    <button name="set_to_draft" string="Set to Draft" invisible="state != 'refuse'" type="object"
                            groups="base.group_user"/>
                    <field name="accounting_info" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Details">
                            <field name="employee_id" readonly = "state != 'draft'"/>
                            <field name="loan_id" options="{'no_create': True}"
                                   readonly = "state != 'draft'"/>
                            <field name="department_id" invisible = "employee_id == False"/>
                            <!--                            <field name="branch_id" groups="multi_branches.group_multi_branch"/>-->
                            <field name="company_id" readonly = "state != 'draft'"
                                   options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                        <group string="Employee Loan Details" invisible = "loan_id == False">
                            <field name="loan_operation_type" readonly = "state != 'draft'" invisible="loan_id == False"/>
                            <field name="decrease_mechanism_type"
                                   readonly = "state != 'draft'" invisible="'|', loan_id == False, loan_operation_type != 'decrease_amount'"/>
                            <field name="current_loan_amount" invisible = "loan_id == False"/>
                            <field name="amount_to_pay" invisible = "loan_id == False"/>
                            <field name="operation_applied" invisible="1"/>
                        </group>
                    </group>
                    <group string="Skip Installment" invisible="loan_id == False or loan_operation_type != 'skip_installment'">
                        <group>
                            <field name="skip_reason" required = "loan_operation_type == 'skip_installment'" readonly="state != 'draft'"/>
                            <field name="effective_date" required = "loan_operation_type == 'skip_installment'" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Loan Payment Details" invisible = "loan_operation_type != 'loan_payment'">
                            <field name="loan_payment_type" widget="radio" options="{'horizontal': true}"
                                   required = "loan_operation_type == 'loan_payment'" readonly="state != 'draft'"/>
                            <field name="payment_type" widget="radio" options="{'horizontal': true}"
                                   required = "loan_operation_type == 'loan_payment', loan_payment_type == 'partially'"/>
                            <field name="payment_amount"
                                   invisible = "loan_payment_type == 'fully'" required="loan_payment_type == 'partially'" readonly="state != 'draft'"/>
                            <field name="effective_date"
                                   required = "loan_operation_type == 'loan_payment'" readonly="state != 'draft'"/>
                        </group>
                        <group string="Increase Loan Amount" invisible = "loan_operation_type != 'increase_amount'">
                            <field name="loan_amount"
                                   required = "loan_operation_type == 'increase_amount'" readonly="state != 'draft'"/>
                            <field name="effective_date"
                                   required = "loan_operation_type == 'increase_amount'" readonly="state != 'draft'"/>
                        </group>
                        <group string="Decrease Loan Amount"
                               invisible = "loan_operation_type != 'decrease_amount'" >
                            <field name="loan_amount"
                                   required = "loan_operation_type == 'decrease_amount'" readonly="state != 'draft'"/>
                            <field name="effective_date"
                                   required = "loan_operation_type == 'decrease_amount'" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>

                        <page string="Extra Information" groups="base.group_no_one" invisible = "state == 'draft'">
                            <group name="extra_info" col="4">
                                <field name="create_uid" readonly="1" invisible = "create_uid == False"/>
                                <field name="create_date" readonly="1" invisible = "create_date == False"/>
                                <field name="write_uid" readonly="1" invisible = "write_uid == False"/>
                                <field name="write_date" readonly="1" invisible = "write_date == False"/>
                                <field name="approved_by" invisible = "approved_by == False"/>
                                <field name="approved_date" invisible = "approved_date == False"/>
                                <field name="refused_by" invisible = "refused_by == False"/>
                                <field name="refused_date" invisible = "refused_date == False"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_loan_operation_filter" model="ir.ui.view">
        <field name="name">hr.loan.operation.filter</field>
        <field name="model">hr.loan.operation</field>
        <field name="arch" type="xml">
            <search string="Search Loan Operation">
                <separator/>
                <filter name="filter_approve" domain="[('state','=','draft')]" string="To Approve"/>
                <filter domain="[('state','=','approve')]" string="Approved" name="approved"/>
                <separator/>
                <filter string="My Loan Operations" name="my_loan_operation_type"
                        domain="[('employee_id.user_id','=', uid)]" help="My Loan Operations"/>
                <separator/>
                <filter string="My Department Loan Operations" name="filter_my_department_loan_operation"
                        help="My Department Loans" domain="[('department_id.manager_id.user_id','=',uid)]"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="loan_operation_type"/>
                <group expand="0" string="Group By...">
                    <filter name="group_request" string="Request Date" context="{'group_by':'effective_date'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by':'department_id','set_visible':True}"/>
                    <filter name="group_status" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_loan_operation" string="Loan Operations"
                            context="{'group_by': 'loan_operation_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_loan_operation">
        <field name="name">Loan Operations</field>
        <field name="res_model">hr.loan.operation</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_loan_operation_type':1}</field>
    </record>

    <menuitem name="Loan Operation Request" id="menu_loan_operation" parent="saudi_hr_loan.menu_hr_loan"
              action="action_loan_operation" sequence="3"/>
</odoo>
