<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Thermal report for Picking Operations -->
        <record id="action_report_picking_thermal" model="ir.actions.report">
            <field name="name">Picking Operations (Thermal)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">stock_thermal_reports.report_picking_thermal</field>
            <field name="report_file">stock_thermal_reports.report_picking_thermal</field>
            <field name="print_report_name">'Picking Operations - %s - %s' % (object.partner_id.name or '',
                object.name)
            </field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Thermal report for Delivery Slip -->
        <record id="action_report_delivery_thermal" model="ir.actions.report">
            <field name="name">Delivery Slip (Thermal)</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">stock_thermal_reports.report_deliveryslip_thermal</field>
            <field name="report_file">stock_thermal_reports.report_deliveryslip_thermal</field>
            <field name="print_report_name">'Delivery Slip - %s - %s' % (object.partner_id.name or '',
                object.name)
            </field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>