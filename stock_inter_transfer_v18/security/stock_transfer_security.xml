<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Stock Transfer Access Rules for Users with Location Restrictions -->
        <record id="stock_transfer_location_rule" model="ir.rule">
            <field name="name">Stock Transfer: Location Access Rule</field>
            <field name="model_id" ref="model_stock_transfer"/>
            <field name="domain_force">['|', '|',
                ('location_id', 'in', user.location_ids.ids),
                ('location_dest_id', 'in', user.location_ids.ids),
                ('create_uid', '=', user.id)
            ]</field>
            <field name="global" eval="True"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Stock Transfer Manager Access Rule (Full Access) -->
        <record id="stock_transfer_manager_rule" model="ir.rule">
            <field name="name">Stock Transfer: Manager Full Access</field>
            <field name="model_id" ref="model_stock_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

