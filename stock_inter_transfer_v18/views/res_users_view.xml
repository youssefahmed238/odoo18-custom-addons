<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_config_settings_view_form_inherit_inter_stock" model="ir.ui.view">
        <field name="name">res.users.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <label for="allow_done_exceeds_demand"/>
                <field name="allow_done_exceeds_demand"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <group>
                    <field name="use_locations" string="Use Locations"/>
                    <field name="location_ids" string="Locations" widget="many2many_tags" invisible="not use_locations"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="stock_backorder_confirmation_inherit" model="ir.ui.view">
        <field name="name">stock.backorder.confirmation.inherit</field>
        <field name="model">stock.backorder.confirmation</field>
        <field name="inherit_id" ref="stock.view_backorder_confirmation"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='process_cancel_backorder']" position="replace">
                <button name="process_cancel_backorder2" string="No Backorder" type="object"
                        class="btn-danger text-uppercase" invisible="show_transfers" data-hotkey="w"/>
            </xpath>
        </field>
    </record>

</odoo>
