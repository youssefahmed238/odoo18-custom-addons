<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_transfer_form_inherit_report_button" model="ir.ui.view">
        <field name="name">stock.transfer.form.inherit.report.button</field>
        <field name="model">stock.transfer</field>
        <field name="inherit_id" ref="stock_inter_transfer_v18.view_stock_transfer_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(stock_inter_transfer_v18.action_report_stock_transfer)d" type="action" string="Print Transfer" class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
