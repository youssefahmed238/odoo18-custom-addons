<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_config_settings_view_form_inherit_inter_stock" model="ir.ui.view">
        <field name="name">stock.config.settings.inherit.inter.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <setting id="warning_info" position="after">
                <setting id="internal_transfer_approval" string="Approve Inter Warehouse Transfers" help="The approval of the responsible person will be needed to transfer the stock from one warehouse to another">
                    <field name="transfer_approval_required"/>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
