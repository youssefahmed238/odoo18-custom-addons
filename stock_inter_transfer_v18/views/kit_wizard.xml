<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_transfer_kit_wizard_form" model="ir.ui.view">
        <field name="name">stock.transfer.kit.wizard.form</field>
        <field name="model">stock.transfer.kit.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Kit Product" create="false" edit="false">
                <group>
                    <field name="kit_product_id" required="1"/>
                    <field name="bom_domain_ids" invisible="1"/>
                    <field name="bom_id" required="1" />
                    <field name="kit_quantity" required="1"/>
                </group>
                <footer>
                    <button name="action_add_kit_to_transfer" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_transfer_kit_wizard" model="ir.actions.act_window">
        <field name="name">Add Kit Product</field>
        <field name="res_model">stock.transfer.kit.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_stock_transfer_kit_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
