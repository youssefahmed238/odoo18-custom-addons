<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_request_tree" model="ir.ui.view">
        <field name="name">Request Product</field>
        <field name="model">product.request</field>
        <field name="arch" type="xml">
            <list string="Request Product">
                <field name="order_number"/>
                <field name="created_by"/>
                <field name="order_date"/>
                <field name="source"/>
                <field name="destination"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_product_request_form" model="ir.ui.view">
        <field name="name">product.request.form</field>
        <field name="model">product.request</field>
        <field name="arch" type="xml">
            <form string="Request Product">
                <header>
                    <button name="action_submitted" string="Submit" type="object" class="oe_highlight" invisible="state != 'to_submit'"/>
                    <button name="action_rejected" string="Reject" type="object" invisible="state != 'submitted'"/>
                    <button name="action_approved" string="Approve" type="object" invisible="state != 'submitted' or user_use_locations"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_submit,submitted,rejected,approved"/>
                    <field name="user_use_locations" invisible="1"/>
                </header>
                <sheet>
                    <h1 class="o_form_title">
                        <field name="order_number"/>
                    </h1>
                    <group>
                        <field name="created_by" readonly="1"/>
                        <field name="order_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="source"/>
                        <field name="destination"/>
                    </group>

                    <notebook>
                        <page string="Details">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" string="Product"/>
                                    <field name="product_uom_qty" string="Quantity"/>
                                    <field name="available_uom_ids" invisible="1"/>
                                    <field name="product_uom" domain="[('id', 'in', available_uom_ids)]"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_request_user_rule" model="ir.rule">
        <field name="name">Product Request User Rule</field>
        <field name="model_id" ref="stock_inter_transfer_v18.model_product_request"/>
        <field name="domain_force">[
            '|', '|',
            ('source', 'in', user.location_ids.ids if user.use_locations else []),
            ('destination', 'in', user.location_ids.ids if user.use_locations else []),
            (not user.use_locations, '=', True)
            ]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="action_product_request" model="ir.actions.act_window">
        <field name="name">Product Request</field>
        <field name="res_model">product.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('accessible_to_user', '=', True)]</field>
    </record>

    <record id="action_request_product" model="ir.actions.act_window">
        <field name="name">Request Product</field>
        <field name="res_model">product.request</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Request Product
            </p>
        </field>
    </record>

    <menuitem
            action="action_request_product"
            id="request_product_menu"
            parent="stock.menu_stock_root"
            sequence="7"
            name="Request Product"/>

</odoo>
