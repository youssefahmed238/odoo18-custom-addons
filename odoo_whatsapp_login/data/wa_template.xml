<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="whatsapp_otp_template" model="whatsapp.template">
            <field name="name">WhatsApp OTP Template</field>
            <field name="template_name">whatsapp_otp_template</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="template_category">template</field>
            <field name="status">draft</field>
            <field name="template_type">authentication</field>
            <field name="lang_code">en</field>
            <field name="body">{{1}} is your verification code. For your security, do not share this code</field>
        </record>
        <record id="wa_otp_template_button" model="whatsapp.template.button">
            <field name="button_type">url</field>
            <field name="wa_template_id" ref="odoo_whatsapp_login.whatsapp_otp_template"/>
            <field name="name">Copy Code</field>
            <field name="url_type">dynamic</field>
            <field name="website_url">http://www.otp-example.in/{{1}}</field>
        </record>

        <record id="whatsapp_reset_password_template" model="whatsapp.template">
            <field name="name">WhatsApp Reset Password Template</field>
            <field name="template_name">whatsapp_reset_password_template</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="template_category">template</field>
            <field name="status">draft</field>
            <field name="template_type">utility</field>
            <field name="lang_code">en</field>
            <field name="body">Dear {{1}},

A password reset was requested for the Odoo account linked to this WhatsApp Number
You may change your password by following this link: {{2}}

If you do not expect this, you can safely ignore this whatsapp message.
Thanks.</field>
        </record>
    </data>
</odoo>