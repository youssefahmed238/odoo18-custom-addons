<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_payment_thermal">
            <t t-set="report_type" t-value="'html'"/>
            <t t-if="not thermal_width">
                <t t-set="thermal_width" t-value="user.thermal_size or '80mm'"/>
            </t>

            <style type="text/css">
                @page {
                size: auto;
                margin: 0 !important;
                }

                .my_container {
                width:
                <t t-esc="thermal_width"/>
                !important;
                }
            </style>

            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <t t-set="values" t-value="o._get_payment_receipt_report_values()"/>
                <link rel="stylesheet" href="/vit_html_thermal_base/static/src/css/thermal_style.css"/>

                <center class="thermal-report-page">
                    <div class="my_container">

                        <!-- Company Logo -->
                        <div style="width: 45%; margin: 0 auto;">
                            <img t-att-src="'data:image/png;base64,' + o.company_id.logo.decode()"
                                 style="width:100%"/>
                        </div>

                        <div class="thermal-section">
                            <!-- Company Name -->
                            <div style="margin-top:10px; font-weight: bold;">
                                <span t-esc="o.company_id.name"/>
                            </div>

                            <!-- Company Address -->
                            <div style="margin-top:10px; font-weight: bold;">
                                <div t-field="o.company_id.partner_id"
                                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </div>

                            <!-- VAT Number -->
                            <div t-if="o.company_id.vat" style="margin-top:10px; font-weight: bold;">
                                VAT Number :
                                <span t-esc="o.company_id.vat"/>
                            </div>
                        </div>
                        <div class="thermal-section">
                            <table class="thermal-table">
                                <tbody>
                                    <t t-if="o.name">
                                        <tr>
                                            <td style="text-align:left;font-weight: bold;">Receipt No:</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.name"/>
                                            </td>
                                            <td style="text-align:right;font-weight: bold;">:رقم الاستلام</td>
                                        </tr>
                                    </t>

                                    <t t-if="o.date">
                                        <tr>
                                            <td style="text-align:left; font-weight: bold;">Date:</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.date"/>
                                            </td>
                                            <td style="text-align:right;font-weight: bold;">:التاريخ</td>
                                        </tr>
                                    </t>

                                    <t t-if="o.partner_id.name">
                                        <tr>
                                            <td style="text-align:left;width:25%;font-weight: bold;">Customer Name:</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.partner_id.name"/>
                                            </td>
                                            <td style="text-align:right;width:25%;font-weight: bold;">:اسم العميل
                                            </td>
                                        </tr>
                                    </t>

                                    <t t-if="o.partner_id.contact_address">
                                        <tr>
                                            <td style="text-align:left;font-weight: bold;">Customer Address:</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.partner_id.contact_address"/>
                                            </td>
                                            <td style="text-align:right;font-weight: bold;">:عنوان العميل</td>
                                        </tr>
                                    </t>

                                    <t t-if="o.partner_id.phone">
                                        <tr>
                                            <td style="text-align:left;font-weight: bold;">Tel No:</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.partner_id.phone"/>
                                            </td>
                                            <td style="text-align:right;font-weight: bold;">:رقم هاتف العميل</td>
                                        </tr>
                                    </t>

                                    <t t-if="o.memo">
                                        <tr>
                                            <td style="text-align:left;font-weight: bold;">Memo :</td>
                                            <td style="text-align:center;font-weight: bold;">
                                                <span t-esc="o.memo"/>
                                            </td>
                                            <td style="text-align:right;font-weight: bold;">: مذكرة</td>
                                        </tr>
                                    </t>

                                </tbody>
                            </table>
                        </div>

                        <!-- Invoices Table -->
                        <div t-if="values['display_invoices'] and o.reconciled_invoice_ids or o.reconciled_bill_ids"
                             class="thermal-section">
                            <t t-set="invoices" t-value="o.reconciled_invoice_ids or o.reconciled_bill_ids"/>

                            <!-- Check if invoices include different currencies -->
                            <t t-set="otherCurrency" t-value="False"/>
                            <t t-foreach="invoices" t-as="inv">
                                <t t-if="any(inv.currency_id != par[2].currency_id for par in inv._get_reconciled_invoices_partials()[0])"
                                   t-set="otherCurrency" t-value="True"/>
                            </t>

                            <table class="thermal-table">
                                <thead>
                                    <tr>
                                        <th style="text-align:left; width:3%;">#</th>
                                        <th style="text-align: left; width: 20%;">
                                            <span>Invoice Date</span>
                                        </th>
                                        <th style="text-align: center; width: 30%;">
                                            <span>Invoice Number</span>
                                        </th>
                                        <th style="text-align: center; width: 20%;">
                                            <span>Ref</span>
                                        </th>
                                        <th t-if="otherCurrency">
                                            <span>Amount In Currency</span>
                                        </th>
                                        <th style="text-align: center; width: 25%;">
                                            <span>Amount</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="line_sequence" t-value="1"/>

                                    <t t-foreach="invoices" t-as="inv">
                                        <!-- Invoice Line -->
                                        <t t-if="inv.move_type != 'entry'">
                                            <tr>
                                                <td>
                                                    <t t-esc="line_sequence"/>
                                                    <t t-set="line_sequence" t-value="line_sequence + 1"/>
                                                </td>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top;">
                                                    <span t-field="inv.invoice_date"/>
                                                </td>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top;">
                                                    <span t-field="inv.name"/>
                                                </td>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top; font-size: 9px;">
                                                    <span t-field="inv.ref"/>
                                                </td>
                                                <t t-if="otherCurrency"/>
                                                <td style="text-align: center; overflow-wrap: anywhere; vertical-align: top;">
                                                    <span t-field="inv.amount_total"/>
                                                </td>
                                            </tr>

                                            <!-- Payment/Reversal Lines -->
                                            <tr t-foreach="inv._get_reconciled_invoices_partials()[0]" t-as="par">
                                                <td>
                                                    <t t-esc="line_sequence"/>
                                                    <t t-set="line_sequence" t-value="line_sequence + 1"/>
                                                </td>
                                                <t t-set="payment" t-value="par[2]"/>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top;">
                                                    <span t-field="payment.move_id.date"/>
                                                </td>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top;">
                                                    <span t-field="payment.move_id.name"/>
                                                </td>
                                                <td style="word-wrap: break-word; white-space: normal; vertical-align: top; font-size: 8px;">
                                                    <span t-field="payment.payment_id.memo"/>
                                                </td>

                                                <t t-set="amountPayment"
                                                   t-value="-(par[0].debit_amount_currency if par[2].debit > 0 else par[0].credit_amount_currency)"/>
                                                <t t-set="amountInvoice" t-value="-par[1]"/>
                                                <t t-set="currencyPayment" t-value="payment.currency_id"/>
                                                <t t-set="currencyInvoice" t-value="inv.currency_id"/>

                                                <td t-if="otherCurrency" class="text-end">
                                                    <span t-if="currencyPayment != currencyInvoice"
                                                          t-out="amountPayment"
                                                          t-options="{'widget': 'monetary', 'display_currency': currencyPayment}">
                                                        50.00 EUR
                                                    </span>
                                                </td>

                                                <!-- Amount In Invoice Currency -->
                                                <td style="text-align: center   ; overflow-wrap: anywhere; vertical-align: top;">
                                                    <span t-out="amountInvoice"
                                                          t-options="{'widget': 'monetary', 'display_currency': currencyInvoice}"/>
                                                </td>
                                            </tr>

                                            <!-- Balance/Due Amount -->
                                            <tr style="font-weight: bold; border-top: 1px solid #000;">
                                                <td>
                                                    <t t-esc="line_sequence"/>
                                                    <t t-set="line_sequence" t-value="line_sequence + 1"/>
                                                </td>

                                                <td>
                                                </td>

                                                <td colspan="2" style="word-wrap: break-word; white-space: normal;">
                                                    Due Amount for
                                                    <span t-field="inv.name"/>
                                                </td>

                                                <td t-if="otherCurrency"/>

                                                <td style="text-align: center; overflow-wrap: anywhere;">
                                                    <span t-field="inv.amount_residual"/>
                                                </td>
                                            </tr>

                                            <!-- Spacing between invoices -->
                                            <tr t-if="not inv_last" style="height: 5px;">
                                                <td colspan="99" style="border-bottom: 1px dashed #ccc;"/>
                                            </tr>
                                        </t>
                                    </t>
                                </tbody>
                            </table>

                        </div>

                    </div>
                </center>
            </t>
        </template>

    </data>
</odoo>