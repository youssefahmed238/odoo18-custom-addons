<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_warehouse_product_thermal">
            <t t-set="report_type" t-value="'html'"/>
            <t t-if="not thermal_width">
                <t t-set="thermal_width" t-value="user.thermal_size or '80mm'"/>
            </t>

            <style type="text/css">
                @page {
                size: auto;
                margin: 0 !important;
                }

                .my_container {
                width:
                <t t-esc="thermal_width"/>
                !important;
                }
            </style>

            <t t-if="not docs">
                <div style="text-align: center; font-size: 14px; margin-top: 20px;">
                    No data available to display.
                </div>
                <div class="rtl-text" style="text-align: center; font-size: 14px; margin-top: 20px;">
                    لا توجد بيانات لعرضها.
                </div>
            </t>
            <t t-else="">
                <script type="text/javascript">
                    window.onload = function () {
                    window.print();
                    };
                </script>


                <t t-set="first_item" t-value="docs[0]"/>
                <link rel="stylesheet" href="/vit_html_thermal_base/static/src/css/thermal_style.css"/>

                <t t-set="products" t-value="first_item.get_warehouse_products(docs)"/>

                <center class="thermal-report-page">
                    <div class="my_container">

                        <!-- Company Logo -->
                        <div style="width: 45%; margin: 0 auto;">
                            <img t-att-src="'data:image/png;base64,' + first_item.company_id.logo.decode()"
                                 style="width:100%"/>
                        </div>

                        <!-- Company Name -->
                        <div style="margin-top:10px; font-weight: bold;">
                            <span t-esc="first_item.company_id.name"/>
                        </div>

                        <!-- Company Address -->
                        <div style="margin-top:10px; font-weight: bold;">
                            <div t-field="first_item.company_id.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                        </div>

                        <!-- VAT Number -->
                        <div style="margin-top:10px; font-weight: bold;">
                            VAT Registration No :
                            <span t-esc="first_item.company_id.vat"/>
                        </div>

                        <!-- Warehouse Title -->
                        <div class="thermal-section">
                            <table class="thermal-table" style="font-weight: bold; font-size: 14px;">
                                <tr>
                                    <td style="width: 40%;">
                                        <div style="text-align: left">
                                            Warehouse:
                                        </div>
                                    </td>
                                    <td>
                                        <div style="text-align: right">
                                            <span t-esc="first_item.warehouse_id.name"/>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Products with Locations -->
                        <div class="thermal-section" style="border-bottom: none;">
                            <div style="margin-bottom: 10; page-break-inside: avoid;">

                                <!-- Locations & Quantities Table -->
                                <table class="thermal-table">
                                    <thead>
                                        <!--                                            <tr style="font-weight: bold;">-->
                                        <!--                                                <th style="text-align: left; width: 25%; font-size: 12px;">-->
                                        <!--                                                    Product:-->
                                        <!--                                                </th>-->
                                        <!--                                                <th style="font-size: 12px; text-align: center">-->
                                        <!--                                                    <div>-->
                                        <!--                                                        <span t-esc="product.with_context(lang='en_US').name"/>-->
                                        <!--                                                    </div>-->
                                        <!--                                                    <div>-->
                                        <!--                                                        <span t-esc="product.with_context(lang='ar_001').name"/>-->
                                        <!--                                                    </div>-->
                                        <!--                                                </th>-->
                                        <!--                                                <th style="text-align: right; width: 20%; font-size: 12px;">-->
                                        <!--                                                    :المنتج-->
                                        <!--                                                </th>-->
                                        <!--                                            </tr>-->
                                        <tr>
                                            <th style="text-align: center; width: 10%;">#</th>
                                            <th style="width: 30%; text-align: left;">
                                                <div>Product</div>
                                                <div>المنتج</div>
                                            </th>
                                            <th style="text-align: left; width: 30%;">
                                                <div>Location</div>
                                                <div>الموقع</div>
                                            </th>
                                            <th style="text-align: center;">
                                                <div>Quantity</div>
                                                <div>الكمية</div>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="seq" t-value="1"/>
                                        <!--                                            <t t-set="total_qty" t-value="0"/>-->
                                        <t t-foreach="products['products']" t-as="product">
                                            <t t-foreach="products[product.id]" t-as="locations_qty">
                                                <tr>
                                                    <td style="text-align: center;">
                                                        <span t-esc="seq"/>
                                                        <t t-set="seq" t-value="seq + 1"/>
                                                    </td>
                                                    <td style="text-align: left; word-wrap: break-word; white-space: normal; font-weight: bold;">
                                                        <div>
                                                            <span t-esc="product.with_context(lang='en_US').name"/>
                                                        </div>
                                                        <!--                                                        <div>-->
                                                        <!--                                                            <span t-esc="product.with_context(lang='ar_001').name"/>-->
                                                        <!--                                                        </div>-->
                                                    </td>
                                                    <td style="text-align: left; word-wrap: break-word; white-space: normal; font-weight: normal;">
                                                        <span class="thermal-product-name"
                                                              t-esc="locations_qty[0].complete_name"/>
                                                    </td>
                                                    <td class="thermal-qty" style="font-weight: normal;">
                                                        <span t-esc="locations_qty[1]"/>
                                                        <!--                                                        <t t-set="total_qty" t-value="total_qty + locations_qty[1]"/>-->
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                        <!-- Total Row -->
                                        <!--                                            <tr style="border-top: 2px solid #000; font-weight: bold;">-->
                                        <!--                                                <td style="text-align: left; padding: 5px 2px;">-->
                                        <!--                                                    <div>Total</div>-->
                                        <!--                                                    <div>الإجمالي</div>-->
                                        <!--                                                </td>-->
                                        <!--                                                <td>-->

                                        <!--                                                </td>-->
                                        <!--                                                <td class="thermal-qty" style="font-size: 11px; padding: 5px 2px;">-->
                                        <!--                                                    <span t-esc="total_qty"/>-->
                                        <!--                                                </td>-->
                                        <!--                                            </tr>-->
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Generation Timestamp -->
                        <div style="text-align: center; font-size: 10px; margin-bottom: 5px; border-top: 1px solid black; padding-top: 5px;">
                            Generated on
                            <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                        </div>
                        <div style="text-align: center; font-size: 10px; margin-bottom: 5px; padding-top: 5px;">
                            تم الإنشاء في
                            <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                        </div>
                    </div>
                </center>
            </t>
        </template>

    </data>
</odoo>