<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Check every day if contract end date has passed to set it to expired -->
        <record id="ir_cron_check_expired_contracts" model="ir.cron">
            <field name="name">vit Contract Management: Check Expired Insurance Contracts</field>
            <field name="model_id" ref="vit_contract_management.model_insurance_contract"/>
            <field name="state">code</field>
            <field name="code">model.check_expired_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

    </data>
</odoo>