<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_salr_document_form" model="ir.ui.view">
        <field name="name">view.custom.sale.document.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//sheet//div//button" position="after">
                <button name="action_see_documents"
                    string="Documents"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="document_count"/></span>
                        <span class="o_stat_text">Documents</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
